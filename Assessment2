package Assessment;

import org.openqa.selenium.chrome.ChromeDriver;
import java.time.Duration;
import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
public class Day1_Assessment2 {
	public static void main(String[] args) throws Exception {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(30));
		driver.get("https://www.myntra.com");
		Thread.sleep(5000);
		driver.findElement(By.className("desktop-searchBar")).sendKeys("birkenstock");
		driver.findElement(By.xpath("//li[text()='Birkenstock Footwear']")).click();
		WebElement product = driver.findElement( By.xpath("(//span[contains(@class,'product-wishlist')])[9]"));		
		JavascriptExecutor js = (JavascriptExecutor)driver;
		js.executeScript("arguments[0].click()",product);
		System.out.println("Product added to Wishlist");

		driver.quit();

	}

}
