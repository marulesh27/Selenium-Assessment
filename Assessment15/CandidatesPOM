package pomutilities;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;

public class CandidatesPOM {
	WebDriver driver4;
	public CandidatesPOM(WebDriver driver4) {
		this.driver4 = driver4;
		PageFactory.initElements(driver4, this);
	
	}

	// Candidates
		@FindBy(xpath = "//a[text()='Candidates']")
		private WebElement candidates;
		@FindBy(xpath = "//label[text()='Job Title']/../following-sibling::div//div[contains(@class,'oxd-select-text')]")
		private WebElement jobTitle;
		@FindBy(xpath = "//label[text()='Vacancy']/../following-sibling::div//div[contains(@class,'oxd-select-text')]")
		private WebElement searchVacancy;
		@FindBy(xpath = "//label[text()='Hiring Manager']/../following-sibling::div//div[contains(@class,'oxd-select-text')]")
		private WebElement hiringManager;
		@FindBy(xpath = "//label[text()='Status']/../following-sibling::div//div[contains(@class,'oxd-select-text')]")
		private WebElement status;
		@FindBy(xpath = "//label[text()='Candidate Name']/../following-sibling::div//input")
		private WebElement candidateName;
		@FindBy(xpath = "//label[text()='Date of Application']/../following-sibling::div//input")
		private WebElement searchDate;
		@FindBy(xpath = "//button[@class='oxd-button oxd-button--medium oxd-button--secondary orangehrm-left-space']")
		private WebElement searchButton;
		
		@FindBy(xpath = "//div[@role='row']//div")
		private List<WebElement> candidateRecord;
		
		public void getCandidates() {
			candidates.click();
		}
		public void getJobTitle() {
			jobTitle.click();
		}
		public void selectJobTitle(String value) {
			driver4.findElement(By.xpath("//span[text()='" + value + "']")).click();
		}
		public void getSearchVacancy() {
			searchVacancy.click();
		}
		public void selectSearchVacancy(String value) {
			driver4.findElement(By.xpath("//span[text()='" + value + "']")).click();
		}
		public void getHiringManager() {
			hiringManager.click();
		}
		public void selectHiringManager(String value) {
			driver4.findElement(By.xpath("//span[text()='" + value + "']")).click();
		}

		public boolean verifyCandidate(String candidateName) {
			for(WebElement rec:candidateRecord) {
				if(rec.getText().equals(candidateName))
					return true;			
			}
			return false;
		}
		
		public void getStatus() {
			status.click();
		}

		public void selectStatus(String value) {
			driver4.findElement(By.xpath("//span[text()='" + value + "']")).click();
		
		}
		public void getCandidateName(String value) {
			candidateName.sendKeys(value);
		}
		public void getSearchDate(String value) {
			searchDate.sendKeys(value);
		}
		public void getSearchButton() {
			searchButton.click();
		}
		

}
